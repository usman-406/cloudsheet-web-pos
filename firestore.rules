rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Products collection
    match /products/{productId} {
      allow read, write: if isValidId(productId);
    }

    // Sales collection
    match /sales/{saleId} {
      allow read, write: if isValidId(saleId);
    }

    // Customers collection
    match /customers/{customerId} {
      allow read, write: if isValidId(customerId);
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // Full System Backups collection (Real-time snapshots & Disaster Recovery archives)
    match /backups/{backupId} {
      allow read, write: if isValidId(backupId);
    }

    // Shifts / Cash Drawer Register collection
    match /shifts/{shiftId} {
      allow read, write: if isValidId(shiftId);
    }

    // Suppliers collection
    match /suppliers/{supplierId} {
      allow read, write: if isValidId(supplierId);
    }

    // Purchase Orders collection
    match /purchase_orders/{poId} {
      allow read, write: if isValidId(poId);
    }

    // Product Returns & Refunds collection
    match /returns/{returnId} {
      allow read, write: if isValidId(returnId);
    }

    // Expenses collection
    match /expenses/{expenseId} {
      allow read, write: if isValidId(expenseId);
    }

    // Employees / Staff collection
    match /employees/{employeeId} {
      allow read, write: if isValidId(employeeId);
    }

    // Payrolls collection
    match /payrolls/{payrollId} {
      allow read, write: if isValidId(payrollId);
    }

    // Coupons & Vouchers collection
    match /coupons/{couponId} {
      allow read, write: if isValidId(couponId);
    }

    // Stock History / Audit Logs collection
    match /stock_history/{historyId} {
      allow read, write: if isValidId(historyId);
    }

    // Audit logs collection
    match /audit_logs/{logId} {
      allow read, write: if isValidId(logId);
    }

    // Stock Reservations collection
    match /reservations/{resId} {
      allow read, write: if isValidId(resId);
    }

    // Notifications & Fraud Alerts collections
    match /notifications/{notifId} {
      allow read, write: if isValidId(notifId);
    }
    match /fraud_alerts/{alertId} {
      allow read, write: if isValidId(alertId);
    }

    // Sync Queue collection
    match /sync_queue/{queueId} {
      allow read, write: if isValidId(queueId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read, write: if isValidId(categoryId);
    }

    // Fallback collection match for system documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

